{
  "name": "fitness-tracker",
  "version": "1.0.0",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "watch": "tsc -w",
    "start": "node dist/index.js",
    "migrate:catalog": "ts-node --transpile-only src/scripts/migrateExerciseCatalog.ts",
    "seed:catalog": "ts-node --transpile-only src/scripts/seedExerciseCatalog.ts"
  },
  "dependencies": {
    "@typegoose/typegoose": "^13.4.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "mongoose": "~9.7.3",
    "reflect-metadata": "^0.2.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^26.2.0",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.9.3"
  }
}
